generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LifecycleStage {
  DESIGN
  PRODUCTION
  SHOOTING
  FINAL_DESTINATION
}

enum AssetCategory {
  GENERIC
  TYPOGRAPHY
  FURNITURE
  PROPS
  WARDROBE
  EQUIPMENT
}

enum LicenseType {
  ORIGINAL
  STOCK_LICENSED
  AI_GENERATED
  PUBLIC_DOMAIN
  UNKNOWN
}

enum LegalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CircularityOutcome {
  REUSED
  DONATED
  RECYCLED
  DISCARDED
  PENDING
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model Asset {
  id           String         @id @default(uuid())
  title        String
  description  String?
  imageUrl     String?
  originalImageUrl String?
  currentStage LifecycleStage @default(DESIGN)
  category     AssetCategory  @default(GENERIC)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  events               LifecycleEvent[]
  rightsRecord         RightsRecord?
  sustainabilityRecord SustainabilityRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assets")
}

model LifecycleEvent {
  id            String          @id @default(uuid())
  assetId       String
  asset         Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  previousStage LifecycleStage?
  newStage      LifecycleStage
  notes         String?
  timestamp     DateTime        @default(now())

  @@map("lifecycle_events")
}

model RightsRecord {
  id            String      @id @default(uuid())
  assetId       String      @unique
  asset         Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  licenseType   LicenseType
  sourceName    String?
  licenseDocUrl String?
  isAiGenerated Boolean     @default(false)
  aiToolName    String?
  legalStatus   LegalStatus @default(PENDING)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("rights_records")
}

model SustainabilityRecord {
  id                 String             @id @default(uuid())
  assetId            String             @unique
  asset              Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  material           String?
  weightKg           Float?
  emissionFactor     Float?
  estimatedCo2eqKg   Float?
  circularityOutcome CircularityOutcome @default(PENDING)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("sustainability_records")
}
